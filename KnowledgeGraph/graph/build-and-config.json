{
  "description": "Build environment, dependencies, cluster configuration, and run commands.",
  "lastUpdated": "2026-05-06",

  "environment": {
    "python": "3.x (venv at Implementation/.venv)",
    "activateLocal_linux": "source /users/student/pg/pg24/yash.sarang/Hybrid-Pairs-Trading-Ensemble/Implementation/.venv/bin/activate",
    "activateLocal_windows": ".venv/Scripts/activate",
    "install": "pip install -r requirements.txt",
    "firstTimeSetup": [
      "python -m venv .venv",
      "source .venv/bin/activate  (Linux) / .venv/Scripts/activate (Windows)",
      "pip install -r requirements.txt"
    ]
  },

  "dependencies": {
    "file": "Implementation/requirements.txt",
    "packages": [
      "streamlit",
      "numpy",
      "pandas",
      "plotly",
      "scikit-learn",
      "xgboost>=2.0",
      "statsmodels",
      "tensorflow[and-cuda]>=2.21.0",
      "yfinance",
      "pytest",
      "joblib"
    ],
    "implicitDeps": [
      "torch + torch-geometric (for GNNSelector — installed separately if needed)",
      "stable-baselines3 (for E8 RL stretch goal — not yet installed)"
    ],
    "gpuSetup": {
      "tensorflow": "tensorflow[and-cuda] bundles CUDA 12 libraries as Python wheels — no separate CUDA install needed",
      "xgboost": "tree_method='hist' + device='cuda' — CUDA support built-in for xgboost>=2.0",
      "fallback": "Both TF and XGBoost have CPU fallbacks; code logs warnings, not errors"
    }
  },

  "cluster": {
    "name": "CMInDS Kalpana cluster",
    "scheduler": "SLURM",
    "projectPath": "/users/student/pg/pg24/yash.sarang/Hybrid-Pairs-Trading-Ensemble",
    "jobScriptsDir": "Implementation/jobs/",
    "logsDir": "Implementation/logs/",
    "concurrentJobsPerUser": 2,
    "jobScripts": {
      "e1_frequency.sh": "E1 frequency comparison (stat_only mode)",
      "e1_frequency_full.sh": "E1 frequency comparison (full mode)",
      "e3_ablation.sh": "E3 ablation study",
      "e3_transformer_rerun.sh": "E3 Transformer_only single-fold re-run (validate Lambda fix)",
      "e4_walk_forward.sh": "E4 walk-forward validation",
      "e6_significance_full.sh": "E6 significance tests on full-mode results",
      "e7_weighted_ensemble.sh": "E7 weighted ensemble (scaffold exists, script not yet built)",
      "run_full_experiments.sh": "Runs E3+E4 sequentially",
      "submit_all.sh": "Submits all jobs via sbatch",
      "test_env.sh": "Verifies GPU/CUDA environment on cluster",
      "bootstrap_pip.sh": "One-time pip install on cluster"
    },
    "usefulCommands": {
      "submitJob": "sbatch jobs/<script>.sh",
      "checkQueue": "squeue -u $(whoami)",
      "watchLog": "tail -f logs/<logfile>.out",
      "checkGPU": "nvidia-smi"
    },
    "resourceAllocation": {
      "E4": "1 GPU, 4 CPUs, 16GB RAM, 12h walltime",
      "E3": "1 GPU, 4 CPUs, 16GB RAM, 10h walltime",
      "E1": "1 GPU, 4 CPUs, 16GB RAM, 8h walltime"
    }
  },

  "localGPU": {
    "hardware": "RTX 4060 Laptop GPU (8 GB VRAM), Driver 595.79, CUDA 12.x",
    "performanceBenchmarks": {
      "LSTMSelector_per_fold": "~3–5 min (was ~60 min CPU-only)",
      "TransformerSelector_per_fold": "~3–5 min (was ~70 min CPU-only)",
      "GNNSelector_per_fold": "~1 min",
      "fullFold_all8Selectors": "~8–12 min (was ~133 min)",
      "6Folds_total": "~50–70 min (was ~13 hours)"
    },
    "vramUsage": {
      "LSTM_BiLSTM32_batch256": "~0.5 GB",
      "Transformer_embed32_heads4_layers2_batch256": "~0.8 GB",
      "GNN_hidden32_N35": "~0.1 GB",
      "totalPeak": "~1.5 GB — well within 8 GB budget"
    },
    "oomFix": "Reduce max_sequences (default 50000) or batch_size (default 256) in selector constructors"
  },

  "runCommands": {
    "streamlitApp": "streamlit run app.py  (from Implementation/)",
    "E4_full_ou_only": "python experiments/walk_forward.py --mode full --s2 ou_only",
    "E4_stat_only": "python experiments/walk_forward.py --mode stat_only --s2 ou_only",
    "E3_ablation_full": "python experiments/ablation.py --mode full",
    "E5_benchmark": "python experiments/benchmark_comparison.py --mode full --s2 ou_only",
    "E6_significance": "python experiments/significance_tests.py --mode full --s2 ou_only",
    "verifyGPU": "python -c \"import tensorflow as tf; print(tf.config.list_physical_devices('GPU'))\""
  }
}
