{
  "description": "Build environment, dependencies, cluster config, and run commands.",
  "lastUpdated": "2026-06-04",
  "environment": {
    "python": "3.x (use 'python' not 'python3' on this machine)",
    "venv": "Implementation/.venv",
    "activateLinux": "source /users/student/pg/pg24/yash.sarang/Hybrid-Pairs-Trading-Ensemble/Implementation/.venv/bin/activate",
    "activateWindows": ".venv/Scripts/activate",
    "install": "pip install -r requirements.txt"
  },
  "dependencies": {
    "core": [
      "streamlit",
      "numpy",
      "pandas",
      "plotly",
      "scikit-learn",
      "xgboost>=2.0",
      "statsmodels",
      "yfinance",
      "pytest",
      "joblib"
    ],
    "ml": [
      "tensorflow>=2.21.0 (CPU build on Kalpana, tensorflow[and-cuda] locally)",
      "torch",
      "torch-geometric (GNNSelector)"
    ],
    "rl": [
      "stable-baselines3 (E8 only \u2014 NOT installed on Kalpana)",
      "gymnasium (NOT installed on Kalpana \u2014 BUG-09)"
    ],
    "note": "CPU-only mandatory on Kalpana. No CUDA packages needed there."
  },
  "mlConfig": {
    "mandatory": "CPU-only on Kalpana",
    "envVars": "CUDA_VISIBLE_DEVICES='' TF_DETERMINISTIC_OPS=1",
    "seed": 42,
    "reason": "Reproducibility. GPU non-determinism would make paper results irreproducible."
  },
  "cluster": {
    "name": "CMInDS Kalpana (SLURM)",
    "projectPath": "/users/student/pg/pg24/yash.sarang/Hybrid-Pairs-Trading-Ensemble",
    "partition": "cn3_anandi",
    "account": "cminds_anandi",
    "qos": "anandi",
    "maxConcurrentJobs": 2,
    "slurmScripts": "Implementation/experiments/slurm/ (active) \u2014 Implementation/jobs/ is ARCHIVED",
    "resourceDefaults": "4 CPUs, 16GB RAM, NO GPU (CPU-only ML). Time: 6-12h per experiment.",
    "usefulCmds": [
      "sbatch experiments/slurm/<script>.sh",
      "squeue -u $(whoami)",
      "sacct -j <jobid> --format=JobID,State,Elapsed,ExitCode -n",
      "tail -f experiments/slurm/logs/<file>.out"
    ],
    "workflowRule": "NEVER edit code directly on Kalpana. Always: local edit -> git push origin main -> ssh kalpana 'git pull origin main' -> sbatch",
    "resultsWorkflow": "On kalpana: git add -A && git commit -m 'results: ...' && git push origin main. Then locally: git pull origin main"
  },
  "localMachine": {
    "os": "Windows 10",
    "shell": "git-bash (POSIX syntax in terminal)",
    "pythonCmd": "python (not python3)",
    "localGPU": "RTX 4060 Laptop 8GB \u2014 available but NOT used for paper results (CPU-only mandate)"
  },
  "runCommands": {
    "streamlit": "streamlit run app.py",
    "wfv_stat_only": "python experiments/walk_forward.py --mode stat_only --s2 ou_only",
    "wfv_full": "python experiments/walk_forward.py --mode full --s2 ou_only",
    "ablation": "python experiments/ablation.py --mode stat_only|stat_ml|full",
    "benchmark": "python experiments/benchmark_comparison.py --mode full --s2 ou_only",
    "significance": "python experiments/significance_tests.py --mode stat_only --s2 ou_only",
    "checkTF": "python -c \"import tensorflow as tf; print(tf.config.list_physical_devices('GPU'))\""
  },
  "dataConfig": {
    "universe": "89 NSE Nifty100 tickers",
    "dateRange": "2015-01-01 to 2024-12-31",
    "parquetCache": "Implementation/experiments/data/nse_nifty100/prices_2015-01-01_2024-12-31.parquet",
    "droppedTickers": [
      "TATAMOTORS",
      "BERGERPAINTS",
      "VODAFONEIDEA",
      "LTIM",
      "ADANITRANS"
    ]
  },
  "currentJobHistory": {
    "E1_wfv_baseline": 8701,
    "E3_ablation_crash1": 8702,
    "E3_ablation_crash2": 8703,
    "E3_ablation_running": 8704
  }
}